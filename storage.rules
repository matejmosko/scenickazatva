rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /festivals/{festivalId}/images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
