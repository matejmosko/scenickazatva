{
  "rules": {
    "appsettings": {
      ".read": "auth != null",
      "predefinedRoles": {
        ".read": "false"
      },
      ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin'"
    },
    "festivals": {
      ".read": "auth != null",
      "$festivalId": {
        "events": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "info": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "locations": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "games": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'",
          "$gameId": {
            ".validate": "newData.hasChildren(['title', 'status'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "status": {
              ".validate": "newData.isString() && newData.val() in ['draft', 'published', 'ended']"
            },
            "questions": {
              "$questionId": {
                ".validate": "newData.hasChildren(['type', 'text'])",
                "text": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
                },
                "type": {
                  ".validate": "newData.isString() && newData.val() in ['text', 'abc', 'sort', 'match', 'textarea']"
                }
              }
            },
            "participants": {
              "$uid": {
                ".validate": "newData.hasChildren(['uid'])",
                "uid": {
                  ".validate": "newData.isString() && newData.val() == $uid"
                },
                "fullName": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "score": {
                  ".validate": "newData.isNumber()"
                },
                "correctCount": {
                  ".validate": "newData.isNumber()"
                },
                "answeredCount": {
                  ".validate": "newData.isNumber()"
                },
                "winner": {
                  ".validate": "newData.isBoolean() && (root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor')"
                }
              }
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['id'])",
        "id": {
          ".validate": "newData.isString() && newData.val() == $uid"
        },
        "userRole": {
          ".write": "false"
        },
        "fullName": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "notifications": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "favorites": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "timestamp": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "fcmtoken": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "game": {
          "$festivalId": {
            "$gameId": {
              ".write": "auth != null && auth.uid == $uid && (!root.child('festivals').child($festivalId).child('games').child($gameId).child('endsAtMs').exists() || root.child('festivals').child($festivalId).child('games').child($gameId).child('endsAtMs').val() == 0 || root.child('festivals').child($festivalId).child('games').child($gameId).child('endsAtMs').val() >= now)",
              "$questionId": {
                ".validate": "newData.hasChildren(['answer', 'correct', 'answeredAt'])",
                "answer": {
                  ".validate": "newData.isMap()"
                },
                "correct": {
                  ".validate": "newData.isBoolean()"
                },
                "answeredAt": {
                  ".validate": "newData.isString()"
                },
                "points": {
                  ".validate": "newData.isNumber()"
                }
              }
            }
          }
        }
      }
    }
  }
}
