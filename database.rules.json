{
  "rules": {
    "appsettings": {
      ".read": "auth != null",
      "predefinedRoles": {
        ".read": "false"
      },
      ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin'"
    },
    "festivals": {
      ".read": "auth != null",
      "$festivalId": {
        "events": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "info": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "locations": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'"
        },
        "games": {
          ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'",
          "$gameId": {
            ".validate": "newData.hasChildren(['title', 'status'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() == 'draft' || newData.val() == 'published' || newData.val() == 'ended')"
            },
            "type": {
              ".validate": "!newData.exists() || newData.isString() && (newData.val() == 'quiz' || newData.val() == 'game' || newData.val() == 'form' || newData.val() == 'live')"
            },
            "timeLimitSeconds": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "showInAds": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "replayable": {
              ".validate": "!newData.exists() || newData.isBoolean()"
            },
            "questions": {
              "$questionId": {
                ".validate": "newData.hasChildren(['type', 'title'])",
                "title": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
                },
                "type": {
                  ".validate": "newData.isString() && (newData.val() == 'text' || newData.val() == 'abc' || newData.val() == 'sort' || newData.val() == 'match' || newData.val() == 'textarea')"
                }
              }
            },
            "participants": {
              "$uid": {
                ".validate": "newData.hasChildren(['uid'])",
                "uid": {
                  ".validate": "newData.isString() && newData.val() == $uid"
                },
                "fullName": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "score": {
                  ".validate": "newData.isNumber()"
                },
                "correctCount": {
                  ".validate": "newData.isNumber()"
                },
                "answeredCount": {
                  ".validate": "newData.isNumber()"
                },
                "winner": {
                  ".validate": "newData.isBoolean() && (root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor')"
                }
              }
            },
            "liveState": {
              ".write": "root.child('users').child(auth.uid).child('userRole').val() == 'admin' || root.child('users').child(auth.uid).child('userRole').val() == 'editor'",
              "currentQuestionId": {
                ".validate": "newData.isString()"
              },
              "isOpen": {
                ".validate": "newData.isBoolean()"
              },
              "openedAt": {
                ".validate": "newData.isString()"
              },
              "timeLimitSeconds": {
                ".validate": "!newData.exists() || newData.isNumber()"
              },
              "controlledBy": {
                ".validate": "!newData.exists() || newData.isString()"
              }
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['id'])",
        "id": {
          ".validate": "newData.isString() && newData.val() == $uid"
        },
        "userRole": {
          ".validate": "newData.val() == '' || newData.val() == null",
          ".write": "false"
        },
        "fullName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "game": {
          "$festivalId": {
            "$gameId": {
              "$questionId": {
                ".validate": "newData.hasChildren(['answer', 'answeredAt'])",
                "answer": {
                  ".validate": "!newData.isString() && !newData.isNumber() && !newData.isBoolean()"
                },
                "correct": {
                  ".validate": "newData.isBoolean()"
                },
                "answeredAt": {
                  ".validate": "newData.isString()"
                },
                "points": {
                  ".validate": "newData.isNumber()"
                }
              }
            }
          }
        }
      }
    }
  }
}
